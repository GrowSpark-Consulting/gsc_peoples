{
  "name": "@gsc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GSC Peoples HR API (Express + Prisma + BullMQ)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate && tsx scripts/gen-tenant-meta.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/database/seeds/index.ts",
    "db:provision:local": "tsx scripts/provision-local.ts",
    "db:studio": "prisma studio",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@gsc/contracts": "workspace:*",
    "@gsc/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^5.0.0",
    "busboy": "1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.0.0",
    "nodemailer": "10.6.1",
    "pg": "^8.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@gsc/config": "workspace:*",
    "@types/busboy": "1.5.4",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.39.5",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
