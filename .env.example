# Copy to .env and fill in. Never commit .env.
# See docs/development/environment.md for the full reference.

# ---------- Local infrastructure ----------
# PostgreSQL = native PostgreSQL 18 service on localhost:5432 (no Docker).
# Redis container port (docker-compose.yml, optional)
REDIS_PORT=6379

# ---------- API (apps/api) ----------
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Dedicated HR database. Never point this at the Project or Sales databases.
# `pnpm db:setup` creates the roles and fills in both URLs for you.
# Runtime URL: least-privilege role hr_app
# postgresql://hr_app:<password>@localhost:5432/hr_db?schema=hr
DATABASE_URL=
# Migration URL: role hr_migrator (used by the Prisma CLI only, never by the running API)
# postgresql://hr_migrator:<password>@localhost:5432/hr_db?schema=hr
DIRECT_URL=

# Optional. When empty, BullMQ queues/workers are disabled (see docs/architecture/overview.md).
# Example: redis://localhost:6379
REDIS_URL=

# ---------- Authentication ----------
# "development" = local-only adapter (refused when NODE_ENV=production)
# "sso"         = Central Authentication (contract pending; fails closed until configured)
AUTH_MODE=development

# Central Authentication - fill in once the platform contract is published
CENTRAL_AUTH_BASE_URL=
CENTRAL_AUTH_JWKS_URL=
CENTRAL_AUTH_ISSUER=
CENTRAL_AUTH_AUDIENCE=

# Development adapter only: default company (tenant) for local requests
DEV_AUTH_COMPANY_ID=dev-company
# Explicit opt-in for the local dev token adapter (also needs NODE_ENV=development). Refused in production.
DEV_AUTH_ENABLED=false

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---------- Integration tests (dedicated hr_test database) ----------
# Written by `pnpm db:test:setup`. Must point at hr_test, never hr_db.
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# ---------- Supabase target (optional; only read when DB_TARGET=supabase) ----------
# DB_TARGET=local            # local (default) | supabase
# SUPABASE_DATABASE_URL=     # hr_app via Session Pooler, ...?schema=hr
# SUPABASE_DIRECT_URL=       # hr_migrator, Prisma CLI only
# SUPABASE_CA_CERT_PATH=     # Supabase CA certificate file (verified TLS is mandatory)

# ---------- Document storage (DOC-001..005) ----------
# DOCUMENT_STORAGE_DRIVER=local            # local (dev/test only) | supabase (REQUIRED when NODE_ENV=production)
# DOCUMENTS_STORAGE_DIR=                   # local driver only; default ./storage/documents
# SUPABASE_STORAGE_URL=                    # https://<project-ref>.supabase.co  (supabase driver)
# SUPABASE_STORAGE_SERVICE_KEY=            # server-side only secret; never expose to the browser
# SUPABASE_STORAGE_BUCKET=hr-documents     # must be a PRIVATE bucket

# ---------- Email (invitations and password resets only) ----------
# Unset in local development: nothing is sent and the API returns the token to the caller.
# Production must set MAIL_DRIVER to smtp or disabled. See docs/development/production-environment-variables.md.
# MAIL_DRIVER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# WEB_APP_URL=http://localhost:3000

# ---------- Operations (optional) ----------
# DATABASE_POOL_MAX=10
# PURGE_COMPANY_IDS=          # retention job: comma-separated company ids
